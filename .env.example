# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Bot Settings
BOT_ADMIN_IDS=123456789,987654321
LOG_LEVEL=INFO
